#, python-brace-format
msgid "Connected to {host}"
msgstr "Ansluten till {host}"

#, python-brace-format
msgid ""
"Could not connect to {host}. Check that the device is on the same network "
"and that wireless debugging is on."
msgstr ""
"Kunde inte ansluta till {host}. Kontrollera att enheten är på samma nätverk "
"och att trådlös felsökning är påslagen."

#, python-brace-format
msgid "{n} device connected"
msgid_plural "{n} devices connected"
msgstr[0] "{n} enhet ansluten"
msgstr[1] "{n} enheter anslutna"

#, python-brace-format
msgid "{n} mirroring"
msgid_plural "{n} mirroring"
msgstr[0] "{n} speglas"
msgstr[1] "{n} speglas"

msgid "No devices connected"
msgstr "Inga enheter anslutna"

msgid "Connect via Wi-Fi"
msgstr "Anslut via Wi-Fi"

msgid "New address..."
msgstr "Ny adress…"

msgid "Pair (wireless debugging)..."
msgstr "Para ihop (trådlös felsökning)…"

msgid "Refresh"
msgstr "Uppdatera"

msgid "Restart adb server"
msgstr "Starta om adb-servern"

msgid "Help"
msgstr "Hjälp"

#, python-brace-format
msgid "About {name}"
msgstr "Om {name}"

msgid "Quit"
msgstr "Avsluta"

msgid "authorize on device"
msgstr "godkänn på enheten"

msgid "offline"
msgstr "svarar inte"

msgid "Stop mirroring"
msgstr "Stoppa speglingen"

msgid "Mirror screen"
msgstr "Spegla skärmen"

msgid "Lock portrait"
msgstr "Lås stående"

msgid "Lock landscape"
msgstr "Lås liggande"

msgid "Auto-rotate"
msgstr "Rotera automatiskt"

msgid "Take screenshot"
msgstr "Ta en skärmdump"

msgid "Open adb shell"
msgstr "Öppna adb shell"

msgid "Disconnect"
msgstr "Koppla från"

msgid "Switch to Wi-Fi"
msgstr "Växla till Wi-Fi"

msgid "Tap Allow in the dialog on the device"
msgstr "Tryck på Tillåt i dialogrutan på enheten"

#, python-brace-format
msgid "Serial number: {serial}"
msgstr "Serienummer: {serial}"

#, python-brace-format
msgid ""
"Mirroring stopped because scrcpy exited with error {code}. The details are "
"in {log}."
msgstr ""
"Speglingen stoppades eftersom scrcpy avslutades med fel {code}. Detaljerna "
"finns i {log}."

msgid ""
"Could not take a screenshot. Check that the device is connected and "
"unlocked, and try again."
msgstr ""
"Det gick inte att ta en skärmdump. Kontrollera att enheten är ansluten och "
"upplåst och försök igen."

#, python-brace-format
msgid "Screenshot saved: {path}"
msgstr "Skärmdumpen är sparad i {path}"

msgid ""
"Could not open adb shell because no terminal program was found. Install one, "
"for example gnome-terminal."
msgstr ""
"Kunde inte öppna adb shell eftersom inget terminalprogram hittades. "
"Installera ett, till exempel gnome-terminal."

msgid ""
"Could not switch to Wi-Fi because the device has no Wi-Fi address. Connect "
"it to a Wi-Fi network and try again."
msgstr ""
"Kunde inte växla till Wi-Fi eftersom enheten saknar Wi-Fi-adress. Anslut den "
"till ett Wi-Fi-nätverk och försök igen."

#, python-brace-format
msgid "Disconnected from {serial}"
msgstr "Frånkopplad från {serial}"

msgid "The adb server has been restarted"
msgstr "adb-servern har startats om"

msgid ""
"The program is free software under the MIT License. The Appninjas name and "
"logo are trademarks of Dvisious AB and are not covered by the MIT License."
msgstr ""
"Programmet är fri programvara under MIT-licensen. Namnet och logotypen "
"Appninjas är varumärken som tillhör Dvisious AB och omfattas inte av MIT-"
"licensen."

msgid "System tray icon for adb devices and scrcpy screen mirroring"
msgstr "Ikon i systemfältet för adb-enheter och skärmspegling med scrcpy"

msgid "Help and common questions"
msgstr "Hjälp och vanliga frågor"

msgid "Source code on GitHub"
msgstr "Källkoden på GitHub"

msgid "Icons: Phosphor Icons, MIT License."
msgstr "Ikoner: Phosphor Icons, MIT-licensen."

msgid "Cancel"
msgstr "Avbryt"

msgid "OK"
msgstr "OK"

msgid "Address (IP:port)"
msgstr "Adress (IP:port)"

msgid "Pair - wireless debugging"
msgstr "Para ihop – trådlös felsökning"

msgid "Pairing address (IP:port)"
msgstr "Parningsadress (IP:port)"

msgid "Pairing code"
msgstr "Parningskod"

msgid "Connection address (optional)"
msgstr "Anslutningsadress (valfri)"

msgid ""
"Pairing failed. Check the pairing address and code under Wireless debugging "
"on the device, and try again."
msgstr ""
"Parningen misslyckades. Kontrollera parningsadressen och koden under Trådlös "
"felsökning på enheten och försök igen."

msgid "Pairing succeeded"
msgstr "Parningen lyckades"

msgid "adb is not installed"
msgstr "adb är inte installerat"

#, python-brace-format
msgid "{name} is already running"
msgstr "{name} körs redan"

msgid "Copy the install command"
msgstr "Kopiera installationskommandot"

msgid "scrcpy is not installed"
msgstr "scrcpy är inte installerat"

msgid "Copied {command}. Paste it into Terminal to install."
msgstr "{command} är kopierat. Klistra in det i Terminal för att installera."

msgid "Could not change Start at login."
msgstr "Kunde inte ändra Starta vid inloggning."

msgid "Start at login"
msgstr "Starta vid inloggning"
